APP_NAME=BookAssistant
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# آدرسی که سایت با آن باز می‌شود. برای اپِ روی گوشی همان IP و پورتی که در تنظیماتِ اپ می‌زنید.
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 🌟 دیتابیسِ این پروژه MySQL است (در Laragon: کاربرِ root بی‌رمز). دیتابیس را قبل از
# migrate بسازید: CREATE DATABASE bookassistant_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bookassistant_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ───────────── تنظیماتِ خاصِ این پروژه ─────────────

# سقفِ حجمِ آپلودِ آرشیوِ کتاب/فایلِ اپ در پنل (مگابایت) و مهلتِ آپلود (دقیقه).
# php.ini هم باید هم‌اندازه باشد: upload_max_filesize = 1024M و post_max_size = 1100M
ARCHIVE_UPLOAD_MAX_MB=1024
ARCHIVE_UPLOAD_MAX_MINUTES=30

# قانونِ رمزِ ثبت‌نام در اپ: strong (۸ نویسه + حروفِ بزرگ/کوچک + عدد + نماد) یا lax (برای تست)
PASSWORD_MODE=strong

# درگاهِ زرین‌پال (config/payment.php؛ حالتِ فعلی: sandbox)
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ZARINPAL_MODE=sandbox

# 🌟 فروش (config/shop.php)
PAYMENT_GATEWAY=zarinpal
PAYMENT_GATEWAY_ENABLED=true
CARD_TRANSFER_ENABLED=false
CARD_TRANSFER_NUMBER=
CARD_TRANSFER_HOLDER=
CARD_TRANSFER_BANK=
CARD_TRANSFER_SHEBA=

# 🌟 پیامک و کدِ ورود (config/sms.php): log | kavenegar | smsir
SMS_DRIVER=log
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=login-otp
KAVENEGAR_ORDER_PAID_TEMPLATE=
KAVENEGAR_ORDER_REJECTED_TEMPLATE=
SMSIR_API_KEY=
SMSIR_OTP_TEMPLATE_ID=
SMSIR_ORDER_PAID_TEMPLATE_ID=
SMSIR_ORDER_REJECTED_TEMPLATE_ID=

# 🌟 امنیت: عمرِ توکنِ اپ به دقیقه (خالی = بی‌انقضا)
SANCTUM_EXPIRATION=525600

# 🌟 DEV-1..4: محدودیتِ دستگاه و مجوزِ آفلاین (config/devices.php)
DEVICE_LIMIT=1
DEVICE_RELEASE_COOLDOWN_DAYS=30
# false فقط برای دوره‌ی کوتاهِ انتشارِ نسخه‌ی تازه‌ی اپ (نسخه‌های قدیمی هنوز وارد شوند)
DEVICE_BINDING_REQUIRED=true
# با `php artisan license:keygen` بسازید؛ کلیدِ عمومی به lib/core/license/license_public_key.dart اپ می‌رود
LICENSE_SIGNING_KEY=
LICENSE_DAYS=30
# 🌟 PAY-5: «تومانِ شناسه»ی کارت‌به‌کارت (۱ تا این عدد به مبلغ اضافه می‌شود؛ 0 = خاموش)
CARD_UNIQUE_MAX=999

# 🌟 SITE-1..9: پیش‌فرض‌ها؛ همه از پنل («تنظیماتِ سایت») هم عوض می‌شوند و مقدارِ پنل مقدم است.
SITE_NAME="آکادمی زبان و آیلتس"
AUTH_MOBILE_ENABLED=true
AUTH_EMAIL_ENABLED=true
AUTH_REGISTRATION_ENABLED=true
SUPPORT_PHONE=
SUPPORT_EMAIL=
SUPPORT_TELEGRAM=
